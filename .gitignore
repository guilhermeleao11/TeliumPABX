# ---- segredos: nunca versionar ----
infra/ansible/group_vars/all/vault.yml
infra/ansible/inventory/vm.ini
api/.env
*.pem
*.key

# ---- dependências (instaladas pelo Ansible na VM) ----
api/vendor/
api/composer.lock

# ---- temporários ----
*.log
*.tmp
*.swp
.DS_Store
api/var/cache/*

# ---- harness de teste local ----
__auto.html

# ---- ajustes de cada servidor (nome, TURN, syslog…): fora do Git ----
# Assim o git pull da atualização nunca conflita com o que é do cliente.
infra/ansible/group_vars/all/servidor.yml
