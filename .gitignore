# ---- segredos: nunca versionar ----
infra/ansible/group_vars/all/vault.yml
infra/ansible/inventory/vm.ini
api/.env
*.pem
*.key

# ---- dependências (instaladas pelo Ansible na VM) ----
api/vendor/
api/composer.lock

# ---- temporários ----
*.log
*.tmp
*.swp
.DS_Store
api/var/cache/*
# dump do SNEP enviado para a migração (tem as senhas SIP): nunca versionar
api/var/migracao-snep/

# ---- harness de teste local ----
__auto.html

# ---- ajustes de cada servidor (nome, TURN, syslog…): fora do Git ----
# Assim o git pull da atualização nunca conflita com o que é do cliente.
infra/ansible/group_vars/all/servidor.yml

# ---- áudios de origem ----
# O que a central usa já está empacotado em infra/ansible/roles/asterisk/
# files/sons/. AudiosCallCenter/ (os originais das mensagens do call
# center) vai no Git; o AudiosPt-br/ é clone de outro projeto, com Git
# próprio, e fica de fora.
AudiosPt-br/
api/COMMIT
api/.env.*

# ---- dumps de centrais antigas (dados de cliente): nunca versionar ----
DumpSnep/

# ajustes antigos, já levados para /etc/telium-servidor.yml
infra/ansible/group_vars/all/servidor.yml.migrado
infra/ansible/group_vars/all/*.antigo

# Arquivos de trabalho da monitoria. O que vai para as centrais está em
# infra/ansible/roles/zabbix (e as senhas em infra/ansible/zabbix-senhas.yml).
ZabbixVoip/
__pycache__/
