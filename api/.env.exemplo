# Modelo. Na VM, o Ansible gera o .env real a partir de group_vars/all/vault.yml.

APP_ENV=desenvolvimento
APP_DEBUG=true
APP_URL=https://pabx.telium.local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=telium_pabx
DB_USER=telium
DB_PASS=troque-esta-senha

AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=telium
AMI_PASS=troque-esta-senha

ARI_URL=http://127.0.0.1:8090/asterisk/ari
ARI_USER=telium
ARI_PASS=troque-esta-senha

ASTERISK_CONF_DIR=/etc/asterisk
ASTERISK_GERADO_DIR=/etc/asterisk/telium
GRAVACOES_DIR=/var/spool/asterisk/monitor

JANUS_WS=wss://pabx.telium.local/janus-ws
JANUS_SIP_PROXY=sip:127.0.0.1:5060

SESSAO_MINUTOS=30
