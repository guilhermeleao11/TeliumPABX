#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * CLI do Telium PABX.
 *   php bin/telium migrar           — aplica os scripts SQL que faltam
 *   php bin/telium gerar-config     — gera os .conf a partir do banco
 *   php bin/telium aplicar-config   — gera e recarrega o Asterisk
 *   php bin/telium doctor           — diagnóstico das dependências
 *   php bin/telium senha <usuario>  — define uma nova senha
 *   php bin/telium testar           — roda a bateria de testes
 */

use Telium\Dominio\Senha;
use Telium\Gerador\Aplicador;
use Telium\Gerador\Gerador;
use Telium\Suporte\Ambiente;
use Telium\Suporte\Ami;
use Telium\Suporte\Bd;
use Telium\Suporte\Testes;

require __DIR__ . '/../vendor/autoload.php';
Ambiente::carregar(__DIR__ . '/../.env');

$verde = "\033[32m"; $vermelho = "\033[31m"; $amarelo = "\033[33m"; $zero = "\033[0m";
$comando = $argv[1] ?? 'ajuda';

try {
    match ($comando) {
        'migrar'         => migrar(),
        'gerar-config'   => gerarConfig(),
        'aplicar-config' => aplicarConfig(),
        'doctor'         => doctor(),
        'senha'          => trocarSenha($argv[2] ?? ''),
        'testar'         => testar(),
        'backup-enviar'  => backupEnviar($argv[2] ?? ''),
        default          => ajuda(),
    };
} catch (Throwable $e) {
    fwrite(STDERR, "{$vermelho}✗ {$e->getMessage()}{$zero}\n");
    exit(1);
}

/**
 * Aplica os scripts de infra/sql na ordem.
 *
 * Todos são idempotentes, então reaplicar é seguro: é o caminho de
 * atualização depois de um git pull, sem precisar do playbook inteiro.
 */
function migrar(): void
{
    global $verde, $vermelho, $amarelo, $zero;

    // Na VM só o api/ é publicado, então os scripts vão junto em
    // {telium_base}/sql; num clone do repositório eles estão em
    // infra/sql. O SQL_DIR do .env tem a última palavra.
    $candidatos = array_filter([
        Ambiente::get('SQL_DIR'),
        __DIR__ . '/../sql',
        __DIR__ . '/../../sql',
        __DIR__ . '/../../infra/sql',
        '/opt/telium/sql',
    ]);

    $dir = false;
    foreach ($candidatos as $tentativa) {
        $caminho = realpath((string) $tentativa);
        if ($caminho !== false && is_dir($caminho) && glob("{$caminho}/*.sql")) {
            $dir = $caminho;
            break;
        }
    }

    if ($dir === false) {
        throw new RuntimeException(
            "Não encontrei os scripts .sql. Procurei em:\n    "
            . implode("\n    ", array_map('strval', $candidatos))
            . "\n  Defina SQL_DIR no .env ou rode o playbook do Ansible, que publica os scripts."
        );
    }

    echo "  scripts em {$dir}\n";

    $arquivos = glob("{$dir}/*.sql") ?: [];
    sort($arquivos);

    if ($arquivos === []) {
        throw new RuntimeException("Nenhum script .sql em {$dir}.");
    }

    $pdo = Bd::conexao();
    $falhas = 0;

    foreach ($arquivos as $caminho) {
        $nome = basename($caminho);
        $sql = (string) file_get_contents($caminho);

        try {
            // Os scripts trazem DELIMITER nenhum e várias instruções por
            // arquivo; o PDO do MySQL aceita isso num exec só.
            $pdo->exec($sql);
            printf("  %s✓ %s%s\n", $verde, $nome, $zero);
        } catch (Throwable $e) {
            $falhas++;
            printf("  %s✗ %s — %s%s\n", $vermelho, $nome, $e->getMessage(), $zero);
        }
    }

    echo $falhas === 0
        ? "{$verde}✓ banco atualizado{$zero}\n"
        : "{$amarelo}• {$falhas} script(s) com erro — veja acima{$zero}\n";

    if ($falhas > 0) {
        exit(1);
    }
}

function gerarConfig(): void
{
    global $verde, $amarelo, $zero;

    $arquivos = (new Gerador())->gerar();
    $mudou = 0;

    foreach ($arquivos as $nome => $info) {
        $cor = $info['status'] === 'inalterado' ? '' : $verde;
        printf("  %s%-28s %-11s %6d bytes%s\n", $cor, $nome, $info['status'], $info['bytes'], $zero);
        if ($info['status'] !== 'inalterado') {
            $mudou++;
        }
    }

    echo $mudou > 0
        ? "{$verde}✓ {$mudou} arquivo(s) gerado(s) — rode 'aplicar-config' para recarregar{$zero}\n"
        : "{$amarelo}• nada mudou{$zero}\n";
}

function aplicarConfig(): void
{
    global $verde, $vermelho, $amarelo, $zero;

    gerarConfig();
    $r = (new Aplicador())->aplicar();

    foreach ($r['etapas'] as $etapa => $estado) {
        $cor = $estado === 'ok' ? $verde : $vermelho;
        printf("  %s%-24s %s%s\n", $cor, $etapa, $estado, $zero);
    }

    if (!$r['sucesso']) {
        echo "{$vermelho}✗ falha ao aplicar{$zero}\n" . $r['saida'];
        exit(1);
    }
    echo "{$verde}✓ configuração aplicada no Asterisk{$zero}\n";
}

function doctor(): void
{
    global $verde, $vermelho, $amarelo, $zero;

    $checar = static function (string $nome, callable $fn) use ($verde, $vermelho, $zero): bool {
        try {
            $detalhe = $fn();
            printf("  %s✓%s %-16s %s\n", $verde, $zero, $nome, $detalhe);
            return true;
        } catch (Throwable $e) {
            printf("  %s✗%s %-16s %s\n", $vermelho, $zero, $nome, $e->getMessage());
            return false;
        }
    };

    $ok = true;
    $ok = $checar('banco', static fn (): string =>
        'MariaDB ' . Bd::valor('SELECT VERSION()') . ' — ' . Bd::valor('SELECT COUNT(*) FROM ramais') . ' ramais') && $ok;

    $ok = $checar('ami', static function (): string {
        $ami = Ami::doAmbiente();
        $ami->conectar();
        $saida = $ami->comando('core show version');
        $ami->desconectar();
        preg_match('/Asterisk\s+\S+/', $saida, $m);
        return $m[0] ?? 'conectado';
    }) && $ok;

    // O Janus é opcional e está desligado por padrão: o WebRTC vai
    // direto ao Asterisk pelo /ws do nginx. Cobrá-lo sempre fazia o
    // diagnóstico de uma instalação normal terminar em vermelho por
    // causa de um serviço que ninguém pediu.
    $ctx = stream_context_create(['http' => ['timeout' => 3]]);
    $janus = @file_get_contents('http://127.0.0.1:8088/janus/info', false, $ctx);
    if ($janus !== false) {
        $ok = $checar('janus', static function () use ($janus): string {
            $d = json_decode($janus, true);
            return 'Janus ' . ($d['version_string'] ?? '?')
                . (isset($d['plugins']['janus.plugin.sip']) ? ' (plugin SIP ok)' : ' (SEM plugin SIP)');
        }) && $ok;
    } else {
        printf("  %s·%s %-16s não instalado (opcional — o WebRTC vai direto ao Asterisk)\n",
            $amarelo, $zero, 'janus');
    }

    $ok = $checar('escrita conf', static function (): string {
        $dir = (string) Ambiente::get('ASTERISK_GERADO_DIR');
        if (!is_writable($dir)) {
            throw new RuntimeException("sem permissão em {$dir}");
        }
        return $dir;
    }) && $ok;

    exit($ok ? 0 : 1);
}

function trocarSenha(string $usuario): void
{
    global $verde, $zero;

    if ($usuario === '') {
        throw new RuntimeException('uso: php bin/telium senha <usuario>');
    }

    // Em terminal, pede a senha sem eco. Num pipe, lê da entrada padrão,
    // o que permite usar em script:  echo 'senha' | php bin/telium senha admin
    $interativo = stream_isatty(STDIN);

    if ($interativo) {
        echo 'Nova senha: ';
        system('stty -echo');
    }

    $senha = trim((string) fgets(STDIN));

    if ($interativo) {
        system('stty echo');
        echo "\n";
    }

    $faltas = Senha::validar($senha);
    if ($faltas !== []) {
        throw new RuntimeException(strtolower(Senha::mensagemDeFalta($faltas)));
    }

    Bd::executar('DELETE FROM sessoes WHERE usuario_id = (SELECT id FROM usuarios WHERE usuario = ?)', [$usuario]);

    $linhas = Bd::executar(
        'UPDATE usuarios SET senha_hash = ?, tentativas_login = 0, bloqueado_ate = NULL WHERE usuario = ?',
        [Senha::criar($senha), $usuario]
    );

    if ($linhas === 0) {
        throw new RuntimeException("usuário {$usuario} não encontrado");
    }
    echo "{$verde}✓ senha de {$usuario} atualizada{$zero}\n";
}

function ajuda(): void
{
    // Heredoc não chama método estático: a versão vem numa variável.
    $versao = Telium\Suporte\Versao::completa();

    echo <<<TXT
    {$versao} — utilitário de linha de comando

      php bin/telium migrar            aplica os scripts SQL que faltam
      php bin/telium gerar-config      gera os .conf a partir do banco
      php bin/telium aplicar-config    gera e recarrega o Asterisk
      php bin/telium doctor            testa banco, AMI, Janus e permissões
      php bin/telium senha <usuario>   define uma nova senha (aceita pipe)
      php bin/telium backup-enviar <id> manda o backup para o destino remoto

    TXT;
}

/**
 * Manda um backup para o destino remoto configurado.
 *
 * Chamado pelo executor logo depois de cada backup concluído, e é por
 * isso que ele existe: a lógica de FTP mora num lugar só, em PHP, em
 * vez de ser repetida em bash com outro jogo de opções do curl.
 *
 * Sai com 0 quando enviou, 1 quando falhou e 0 quando não há destino
 * configurado — não ter para onde mandar é escolha, não erro.
 */
function backupEnviar(string $id): void
{
    global $verde, $vermelho, $amarelo, $zero;

    $id = (int) $id;
    if ($id < 1) {
        fwrite(STDERR, "uso: php bin/telium backup-enviar <id>\n");
        exit(64);
    }

    $destino = \Telium\Dominio\BackupRemoto::destino();
    if (!\Telium\Dominio\BackupRemoto::utilizavel($destino)) {
        echo "{$amarelo}! nenhum destino remoto ligado — o backup fica só no servidor{$zero}\n";
        exit(0);
    }

    $b = Bd::um('SELECT * FROM backups WHERE id = ?', [$id]);
    if ($b === null || ($b['arquivo'] ?? '') === '') {
        fwrite(STDERR, "{$vermelho}✗ backup {$id} não encontrado{$zero}\n");
        exit(1);
    }

    $base = rtrim((string) \Telium\Suporte\Ambiente::get('BACKUP_DIR', '/var/backup/pabx-telium'), '/');
    $caminho = str_starts_with((string) $b['arquivo'], '/')
        ? (string) $b['arquivo']
        : $base . '/' . ltrim((string) $b['arquivo'], '/');

    $r = \Telium\Dominio\BackupRemoto::enviar($caminho, $destino);
    \Telium\Dominio\BackupRemoto::registrar($r['ok'], $r['detalhe']);

    if ($r['ok']) {
        echo "{$verde}✓ {$r['detalhe']}{$zero}\n";
        exit(0);
    }

    fwrite(STDERR, "{$vermelho}✗ {$r['detalhe']}{$zero}\n");
    exit(1);
}

/**
 * Bateria de testes.
 *
 * Roda também na máquina do cliente, depois de instalar ou atualizar: é
 * a forma de conferir que nada do que já foi corrigido voltou.
 */
function testar(): void
{
    global $verde, $vermelho, $amarelo, $zero;

    echo "Telium PABX " . \Telium\Suporte\Versao::NUMERO . " — bateria de testes\n";

    $comBanco = true;
    try {
        Bd::valor('SELECT 1');
    } catch (Throwable $e) {
        $comBanco = false;
        echo "{$amarelo}! sem banco ({$e->getMessage()}) — só os testes que não dependem dele{$zero}\n";
    }

    $r = (new Testes())->rodar($comBanco);

    echo "\n";
    if ($r['falhou'] === 0) {
        echo "{$verde}✓ {$r['passou']} testes, nenhuma falha{$zero}\n";

        return;
    }

    echo "{$vermelho}✗ {$r['falhou']} de " . ($r['passou'] + $r['falhou']) . " falharam{$zero}\n";
    foreach ($r['erros'] as $e) {
        echo "  - {$e}\n";
    }
    exit(1);
}
