# {{ ansible_managed }}
APP_ENV=producao
APP_DEBUG=false
APP_URL=https://{{ pabx_hostname }}

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME={{ db_nome }}
DB_USER={{ db_usuario }}
DB_PASS={{ db_senha }}

AMI_HOST=127.0.0.1
AMI_PORT={{ ami_porta }}
AMI_USER={{ ami_usuario }}
AMI_PASS={{ ami_senha }}

ARI_URL=http://127.0.0.1:{{ ast_http_porta }}/asterisk/ari
ARI_USER={{ ari_usuario }}
ARI_PASS={{ ari_senha }}

ASTERISK_CONF_DIR={{ asterisk_conf_dir }}
ASTERISK_GERADO_DIR={{ asterisk_gerado_dir }}
GRAVACOES_DIR=/var/spool/asterisk/monitor

JANUS_WS=wss://{{ pabx_hostname }}/janus-ws
JANUS_SIP_PROXY=sip:127.0.0.1:{{ sip_porta }}

SESSAO_MINUTOS=30
