# {{ ansible_managed }}
APP_ENV=producao
APP_DEBUG=false
APP_URL=https://{{ pabx_hostname }}

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME={{ db_nome }}
DB_USER={{ db_usuario }}
DB_PASS={{ db_senha }}

AMI_HOST=127.0.0.1
AMI_PORT={{ ami_porta }}
AMI_USER={{ ami_usuario }}
AMI_PASS={{ ami_senha }}

ARI_URL=http://127.0.0.1:{{ ast_http_porta }}/asterisk/ari
ARI_USER={{ ari_usuario }}
ARI_PASS={{ ari_senha }}

# Portas em que o Asterisk escuta. A API gera os transportes do PJSIP a
# partir daqui — trocar a porta continua sendo tarefa do instalador,
# porque o Asterisk não recarrega bind sem reiniciar.
SIP_PORTA={{ sip_porta }}
SIP_TLS_PORTA={{ sip_tls_porta }}
AST_HTTP_PORTA={{ ast_http_porta }}

# NAT: ponto de partida do que o console mostra em Conexões > Rede.
# Depois da primeira gravação por lá, vale o que está no banco.
NAT_IP_PUBLICO={{ nat_ip_publico }}
REDES_LOCAIS={{ redes_locais | join(',') }}

ASTERISK_CONF_DIR={{ asterisk_conf_dir }}
ASTERISK_GERADO_DIR={{ asterisk_gerado_dir }}
GRAVACOES_DIR={{ gravacoes_dir }}
BACKUP_DIR={{ backup_dir }}
AUDIOS_DIR={{ audios_dir }}
CERT_DIR={{ cert_cofre_dir }}
SQL_DIR={{ telium_base }}/sql
TELIUM_ETC={{ telium_etc }}
FOTOS_DIR={{ telium_web }}/uploads/contatos
FOTOS_URL=/uploads/contatos

# Softphone do navegador: SIP sobre WebSocket, pelo nginx, no mesmo
# endereço e certificado do console.
SOFTPHONE_WS=wss://{{ pabx_hostname }}/ws
SIP_DOMINIO={{ pabx_hostname }}

# Servidores de ICE do softphone do navegador. Sem STUN, o navegador só
# oferece o endereço da rede local dele: dentro da empresa funciona, de
# fora o áudio some.
SOFTPHONE_STUN={{ softphone_stun }}

{% if instalar_turn | default(true) %}
# TURN próprio, instalado nesta mesma máquina. A credencial que o
# navegador recebe é gerada a cada entrada, com prazo, a partir deste
# segredo — ele nunca sai do servidor.
SOFTPHONE_TURN=turn:{{ turn_dominio }}:{{ turn_porta }},turn:{{ turn_dominio }}:{{ turn_porta }}?transport=tcp,turns:{{ turn_dominio }}:{{ turn_porta_tls }}?transport=tcp
TURN_SEGREDO={{ turn_segredo_efetivo | default(turn_segredo) }}
TURN_VALIDADE_SEGUNDOS=21600
{% else %}
# TURN de terceiros: preencha os três abaixo.
SOFTPHONE_TURN=
SOFTPHONE_TURN_USUARIO=
SOFTPHONE_TURN_SENHA=
{% endif %}

SESSAO_MINUTOS=30
