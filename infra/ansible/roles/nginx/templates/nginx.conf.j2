# {{ ansible_managed }}
user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

# Sem isto o nginx pede 2048 conexões por processo e o sistema só lhe dá
# 1024 descritores: ele avisa na partida e, na prática, aceita metade do
# que foi configurado. A folga cobre os descritores que não são conexão.
worker_rlimit_nofile 8192;

events {
    worker_connections  2048;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    log_format telium '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" rt=$request_time';
    # O mesmo registro, sem o caminho, para o /p/. A URL do QR Code do
    # Linphone é o próprio token, e token escrito em log é token que vale
    # para quem ler o log nos dez minutos seguintes.
    #
    # A escolha é feita aqui, pelo caminho original, e não com um
    # access_log dentro do "location /p/": o try_files manda o pedido
    # para o "location = /api/index.php", e é o bloco em que o pedido
    # termina que escreve o log — com o $request inteiro.
    log_format telium_sem_caminho '$remote_addr - $remote_user [$time_local] "$request_method /p/…" '
                                  '$status $body_bytes_sent "$http_user_agent" rt=$request_time';

    map $request_uri $telium_log_comum { ~^/p/ 0; default 1; }
    map $request_uri $telium_log_token { ~^/p/ 1; default 0; }

    access_log /var/log/nginx/access.log telium if=$telium_log_comum;
    access_log /var/log/nginx/access.log telium_sem_caminho if=$telium_log_token;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    client_max_body_size 64m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # WebSocket: mapeia o cabeçalho Upgrade
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Teto de tentativas por origem. O bloqueio por conta não segura
    # varredura — o atacante troca de usuário a cada palpite e nunca
    # bloqueia ninguém. Aqui o custo é cortado antes de chegar no PHP,
    # que gasta ~80 ms de CPU em cada conferência de senha.
    limit_req_zone $binary_remote_addr zone=telium_login:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=telium_api:10m   rate=30r/s;
    limit_req_status 429;
    limit_conn_zone $binary_remote_addr zone=telium_conn:10m;

    include /etc/nginx/conf.d/*.conf;
}
