# {{ ansible_managed }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ pabx_hostname }} _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ pabx_hostname }} _;

    ssl_certificate     {{ tls_cert }};
    ssl_certificate_key {{ tls_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root {{ telium_web }};
    index index.html;

    # ---------- front-end estático ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js|svg|png|jpg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # ---------- API (PHP-FPM) ----------
    location /api/ {
        try_files $uri /api/index.php$is_args$args;
    }

    location = /api/index.php {
        include        fastcgi_params;
        fastcgi_pass   unix:/run/php/telium.sock;
        fastcgi_param  SCRIPT_FILENAME {{ telium_api }}/public/index.php;
        fastcgi_param  DOCUMENT_ROOT   {{ telium_api }}/public;
        fastcgi_read_timeout 60s;
        fastcgi_buffers 16 16k;
    }

    # ---------- Janus: API HTTP ----------
    location /janus {
        proxy_pass http://127.0.0.1:{{ janus_http_porta }}/janus;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------- Janus: WebSocket (usado pelo softphone) ----------
    location /janus-ws {
        proxy_pass http://127.0.0.1:{{ janus_ws_porta }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---------- gravações (protegidas pela API) ----------
    location /gravacoes/ {
        internal;
        alias /var/spool/asterisk/monitor/;
    }

    location ~ /\.(?!well-known) { deny all; }
}
