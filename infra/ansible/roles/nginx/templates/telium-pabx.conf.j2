# {{ ansible_managed }}
server {
    listen 80;
    listen [::]:80;
    server_name {{ pabx_hostname }} _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ pabx_hostname }} _;

    ssl_certificate     {{ tls_cert }};
    ssl_certificate_key {{ tls_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    # Só suítes com sigilo futuro e AEAD: sem isto, "HIGH" ainda aceitava
    # CBC com SHA1 e chave RSA estática.
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root {{ telium_web }};
    index index.html;

    # ---------- front-end estático ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Um add_header dentro de um location descarta TODOS os herdados do
    # server, então os de segurança precisam ser repetidos aqui — senão o
    # JavaScript do console era servido sem nosniff e sem HSTS.
    location ~* \.(css|js|svg|png|jpg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # ---------- API (PHP-FPM) ----------
    location /api/ {
        limit_req  zone=telium_api burst=60 nodelay;
        limit_conn telium_conn 40;
        try_files $uri /api/index.php$is_args$args;
    }

    # O login é o alvo da varredura de senha e o mais caro de processar.
    # burst=5 deixa passar o erro de digitação sem deixar passar o robô.
    location = /api/auth/login {
        limit_req zone=telium_login burst=5 nodelay;
        try_files $uri /api/index.php$is_args$args;
    }

    location = /api/index.php {
        include        fastcgi_params;
        fastcgi_pass   unix:/run/php/telium.sock;
        fastcgi_param  SCRIPT_FILENAME {{ telium_api }}/public/index.php;
        fastcgi_param  DOCUMENT_ROOT   {{ telium_api }}/public;
        fastcgi_read_timeout 60s;
        fastcgi_buffers 16 16k;
    }

{% if instalar_janus %}
    # ---------- Janus: API HTTP ----------
    location /janus {
        proxy_pass http://127.0.0.1:{{ janus_http_porta }}/janus;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------- Janus: WebSocket (usado pelo softphone) ----------
    location /janus-ws {
        proxy_pass http://127.0.0.1:{{ janus_ws_porta }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
{% endif %}

    # ---------- softphone: WebSocket do Asterisk ----------
    # O navegador fala SIP sobre WebSocket com o próprio Asterisk. O TLS
    # é este aqui, o mesmo do console: o Asterisk escuta em texto claro
    # no 127.0.0.1 e nunca é exposto direto.
    location /ws {
        proxy_pass http://127.0.0.1:{{ ast_http_porta }}/asterisk/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---------- gravações (protegidas pela API) ----------
    location /gravacoes/ {
        internal;
        alias /var/spool/asterisk/monitor/;
    }

    location ~ /\.(?!well-known) { deny all; }
}
