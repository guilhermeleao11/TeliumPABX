#!/usr/bin/env bash
# =========================================================
# {{ ansible_managed }}
# Telium PABX — ponte entre o console e o fail2ban
#
# O fail2ban bane por IP e só o root fala com ele. Sem esta ponte, um
# ramal que errou a senha cinco vezes — ou o técnico que testou o
# softphone errado — ficava fora do ar por 24 horas, e desbanir exigia
# SSH. Agora o console lista e desbane.
#
# Aceita três comandos e mais nada:
#   listar                    quem está banido, em JSON
#   desbanir <jail> <ip>      tira UM ip de UMA cadeia
#   confiaveis                aplica a lista "nunca bloquear" do console
#                             (tabela firewall_confiaveis) como ignoreip
#
# O jail e o IP são validados aqui, e não no sudoers: é o que permite a
# regra de sudo apontar para um único programa, sem curinga.
# =========================================================
set -uo pipefail

cliente() { fail2ban-client "$@" 2>/dev/null; }

jaulas() {
  cliente status \
    | sed -n 's/.*Jail list:[[:space:]]*//p' \
    | tr ',' '\n' \
    | sed 's/[[:space:]]//g' \
    | grep -v '^$'
}

case "${1:-}" in
  listar)
    primeiro=1
    printf '{"jaulas":['
    while read -r jaula; do
      [ -z "$jaula" ] && continue
      linha=$(cliente status "$jaula" | sed -n 's/.*Banned IP list:[[:space:]]*//p')
      total=$(cliente status "$jaula" | sed -n 's/.*Currently banned:[[:space:]]*//p' | tr -d '[:space:]')
      [ $primeiro -eq 0 ] && printf ','
      primeiro=0
      printf '{"nome":"%s","banidos":%s,"ips":[' "$jaula" "${total:-0}"
      pip=1
      for ip in $linha; do
        [ $pip -eq 0 ] && printf ','
        pip=0
        printf '"%s"' "$ip"
      done
      printf ']}'
    done <<< "$(jaulas)"
    printf ']}\n'
    ;;

  desbanir)
    jaula="${2:-}"
    ip="${3:-}"

    # Nome de jaula é palavra simples; IP é IPv4 ou IPv6. Qualquer coisa
    # fora disso não chega ao fail2ban-client.
    if ! printf '%s' "$jaula" | grep -Eq '^[A-Za-z0-9_-]{1,40}$'; then
      echo "jaula inválida" >&2; exit 2
    fi
    if ! printf '%s' "$ip" | grep -Eq '^[0-9a-fA-F.:]{3,45}$'; then
      echo "endereço inválido" >&2; exit 2
    fi
    if ! jaulas | grep -qx "$jaula"; then
      echo "a cadeia $jaula não existe neste servidor" >&2; exit 3
    fi

    saida=$(cliente set "$jaula" unbanip "$ip")
    rc=$?
    # O fail2ban devolve 0 e a contagem quando desbaniu; quando o IP não
    # estava na lista, ele avisa — e isso não é falha para quem clicou.
    if [ $rc -ne 0 ]; then
      echo "${saida:-o fail2ban recusou o desbanimento}" >&2
      exit 1
    fi
    echo "${saida:-ok}"
    ;;

  confiaveis)
    # A lista vem do banco, e não da linha de comando: a API só manda
    # "aplique", e o que entra no fail2ban é validado aqui, um a um.
    lista=$(mariadb --protocol=socket -uroot -N -B {{ db_nome }} \
              -e "SELECT endereco FROM firewall_confiaveis ORDER BY id" 2>&1)
    if [ $? -ne 0 ]; then
      echo "não foi possível ler a lista do banco: $lista" >&2; exit 1
    fi

    # Validado aqui de novo, e não só na API: este programa roda como
    # root, e uma faixa /0 no ignoreip é o firewall desligado para a
    # internet inteira. IPv4 com octetos até 255 e faixa de /8 a /32;
    # IPv6 com faixa de /16 a /128.
    valido() {
      local e="$1" ip mascara
      ip="${e%%/*}"; mascara=""
      case "$e" in */*) mascara="${e#*/}" ;; esac
      if printf '%s' "$ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        printf '%s' "$ip" | awk -F. '{ for (i = 1; i <= 4; i++) if ($i > 255) exit 1 }' || return 1
        [ -z "$mascara" ] && return 0
        printf '%s' "$mascara" | grep -Eq '^[0-9]{1,2}$' && [ "$mascara" -ge 8 ] && [ "$mascara" -le 32 ]
        return
      fi
      if printf '%s' "$ip" | grep -Eq '^[0-9a-fA-F:]{2,39}$' && printf '%s' "$ip" | grep -q ':'; then
        [ -z "$mascara" ] && return 0
        printf '%s' "$mascara" | grep -Eq '^[0-9]{1,3}$' && [ "$mascara" -ge 16 ] && [ "$mascara" -le 128 ]
        return
      fi
      return 1
    }

    validos=""
    for e in $lista; do
      if valido "$e"; then
        validos="$validos $e"
      else
        echo "ignorado (não é IP nem faixa aceitável): $e" >&2
      fi
    done

    destino=/etc/fail2ban/jail.d/telium-confiaveis.local
    novo=$(mktemp)
    {
      echo "# Gerado pela ponte do console (telium-fail2ban confiaveis)."
      echo "# NÃO EDITE À MÃO: a lista é a de Firewall e Segurança, no console."
      echo "[DEFAULT]"
      echo "ignoreip = 127.0.0.1/8 ::1${validos}"
    } > "$novo"
    install -o root -g root -m 0644 "$novo" "$destino"
    rm -f "$novo"

    # reload relê o ignoreip; quem já estava banido e agora é confiável
    # é solto em todas as cadeias.
    cliente reload >/dev/null || { echo "o fail2ban não recarregou" >&2; exit 1; }
    for e in $validos; do
      case "$e" in */*) continue ;; esac
      while read -r jaula; do
        [ -n "$jaula" ] && cliente set "$jaula" unbanip "$e" >/dev/null
      done <<< "$(jaulas)"
    done

    total=$(printf '%s' "$validos" | wc -w)
    echo "${total} endereço(s) que nunca são bloqueados"
    ;;

  *)
    echo "uso: $(basename "$0") listar | desbanir <jaula> <ip> | confiaveis" >&2
    exit 64
    ;;
esac
