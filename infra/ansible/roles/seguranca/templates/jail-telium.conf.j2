# {{ ansible_managed }}
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = auto

[asterisk]
enabled  = true
port     = {{ sip_porta }},{{ sip_tls_porta }}
protocol = udp
filter   = asterisk
logpath  = /var/log/asterisk/security
maxretry = 5
bantime  = 24h

[asterisk-tcp]
enabled  = true
port     = {{ sip_porta }},{{ sip_tls_porta }}
protocol = tcp
filter   = asterisk
logpath  = /var/log/asterisk/security
maxretry = 5
bantime  = 24h

# Varredura: quem pede um ramal que não existe (os robôs que mandam
# OPTIONS de "sip:1@1" e INVITE para números aleatórios). O Asterisk só
# põe isso no log comum, e não no security, por isso as cadeias acima não
# o viam. Três pedidos numa hora e o IP fica 24 horas sem a porta SIP.
# Não bane tronco nem IP com ramal registrado (telium-fail2ban poupar),
# nem a lista "nunca bloquear" do console.
[asterisk-varredura]
enabled  = true
port     = {{ sip_porta }},{{ sip_tls_porta }}
protocol = udp
filter   = telium-sip-varredura
logpath  = /var/log/asterisk/messages
findtime = 1h
maxretry = 3
bantime  = 24h
ignorecommand = /usr/local/sbin/telium-fail2ban poupar <ip>

[asterisk-varredura-tcp]
enabled  = true
port     = {{ sip_porta }},{{ sip_tls_porta }}
protocol = tcp
filter   = telium-sip-varredura
logpath  = /var/log/asterisk/messages
findtime = 1h
maxretry = 3
bantime  = 24h
ignorecommand = /usr/local/sbin/telium-fail2ban poupar <ip>

# O nginx-http-auth só pega autenticação básica do próprio nginx, que
# este sistema não usa: o login do console é uma chamada JSON. Fica
# desligado para não dar falsa sensação de cobertura.
[nginx-http-auth]
enabled = false

# Entrada no console. O limite por origem da API e o limit_req do nginx
# já seguram a varredura; este bane quem insiste, e vale para o servidor
# inteiro em vez de só para a API.
[telium-console]
enabled  = true
port     = http,https
filter   = telium-console
logpath  = /var/log/nginx/access.log
findtime = 10m
maxretry = 15
bantime  = 1h

[sshd]
enabled = true
