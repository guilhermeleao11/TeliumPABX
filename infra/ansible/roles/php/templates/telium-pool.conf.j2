; {{ ansible_managed }}
[telium]
user  = {{ telium_user }}
group = {{ telium_group }}

listen       = /run/php/telium.sock
listen.owner = nginx
listen.group = nginx
listen.mode  = 0660

pm = dynamic
pm.max_children      = 20
pm.start_servers     = 4
pm.min_spare_servers = 2
pm.max_spare_servers = 6
pm.max_requests      = 500

catch_workers_output = yes
php_admin_value[error_log] = {{ telium_log }}/php-api.log
php_admin_flag[log_errors] = on
php_admin_value[session.save_path] = /var/lib/php/sessions
