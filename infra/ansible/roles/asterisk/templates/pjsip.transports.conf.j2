; {{ ansible_managed }}
; Ponto de partida dos transportes, escrito pelo instalador.
;
; A partir da primeira "Aplicar configurações" quem manda neste arquivo
; é o console (Conexões > Rede), e o conteúdo abaixo é substituído. Ele
; existe para a central ter por onde falar SIP antes disso: sem nenhum
; transporte, o Asterisk sobe sem atender ninguém.

[transport-udp]
type = transport
protocol = udp
bind = 0.0.0.0:{{ sip_porta }}
{% for rede in redes_locais %}
local_net = {{ rede }}
{% endfor %}
{% if nat_ip_publico %}
external_media_address = {{ nat_ip_publico }}
external_signaling_address = {{ nat_ip_publico }}
{% endif %}

[transport-tcp]
type = transport
protocol = tcp
bind = 0.0.0.0:{{ sip_porta }}
{% for rede in redes_locais %}
local_net = {{ rede }}
{% endfor %}
{% if nat_ip_publico %}
external_media_address = {{ nat_ip_publico }}
external_signaling_address = {{ nat_ip_publico }}
{% endif %}

; SIP TLS na 5061. O par vem do módulo de certificados do console; até
; alguém enviar um, é o autoassinado de fábrica — o suficiente para
; cifrar a sinalização, mas o telefone vai pedir para confiar nele.
[transport-tls]
type = transport
protocol = tls
bind = 0.0.0.0:{{ sip_tls_porta }}
cert_file = {{ cert_asterisk_dir }}/asterisk.crt
priv_key_file = {{ cert_asterisk_dir }}/asterisk.key
method = tlsv1_2
{% for rede in redes_locais %}
local_net = {{ rede }}
{% endfor %}
{% if nat_ip_publico %}
external_media_address = {{ nat_ip_publico }}
external_signaling_address = {{ nat_ip_publico }}
{% endif %}

; WebRTC: o navegador fala direto com o Asterisk.
;
; Fica preso em 127.0.0.1 porque quem atende o navegador é o nginx, que
; já termina TLS com o certificado do console e repassa em /ws. A
; sinalização chega por ali, mas a mídia sai daqui direto para o
; navegador: sem o endereço público no SDP, o áudio some quando o
; servidor está atrás de NAT.
[transport-wss]
type = transport
protocol = wss
bind = 127.0.0.1:{{ ast_http_porta }}
{% for rede in redes_locais %}
local_net = {{ rede }}
{% endfor %}
{% if nat_ip_publico %}
external_media_address = {{ nat_ip_publico }}
external_signaling_address = {{ nat_ip_publico }}
{% endif %}
