#!/usr/bin/env bash
# =========================================================
# {{ ansible_managed }}
# Telium PABX — disparador do despertador
#
# Roda a cada minuto. A hora marcada por cada ramal está na base do
# próprio Asterisk (família despertar), gravada pelo código *68 do
# dialplan; aqui só comparamos com o relógio e originamos a chamada.
#
# Guardar na base do Asterisk, e não no MariaDB, é de propósito: quem
# escreve é o dialplan, e assim não existe um segundo lugar para o
# mesmo dado ficar desatualizado.
# =========================================================
set -uo pipefail

agora=$(date '+%H%M')
log() { echo "[$(date '+%F %T')] $*"; }

asterisk -rx "core show version" >/dev/null 2>&1 || { log "Asterisk fora; nada a fazer"; exit 0; }

# "/despertar/1001                     : 0730"
asterisk -rx "database show despertar" 2>/dev/null \
  | sed -n 's#^/despertar/\([^ ]*\) *: *\([0-9]\{4\}\).*#\1 \2#p' \
  | while read -r ramal hora; do
      [ -z "$ramal" ] && continue
      [ "$hora" != "$agora" ] && continue

      log "despertando o ramal ${ramal}"
      asterisk -rx "channel originate PJSIP/${ramal} extension s@telium-despertador" >/dev/null 2>&1

      # Um despertador vale uma vez: some depois de tocar, para não
      # ficar ligando de novo nos 59 segundos seguintes.
      asterisk -rx "database del despertar ${ramal}" >/dev/null 2>&1
    done

exit 0
