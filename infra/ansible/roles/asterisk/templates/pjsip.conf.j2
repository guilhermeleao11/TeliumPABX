; {{ ansible_managed }}
; Globais ficam aqui (estático); transportes vêm do console.
; Endpoints e troncos são gerados pela API em {{ asterisk_gerado_dir }}.

[global]
type = global
user_agent = Telium PABX
default_outbound_endpoint = default_outbound
endpoint_identifier_order = ip,username,anonymous

[system]
type = system
timer_t1 = 500
timer_b  = 32000

; ------------------------------------------------------------------
; Transportes: por onde o Asterisk fala SIP.
;
; Ficavam aqui, escritos pelo instalador. Quem instalasse atrás de NAT e
; descobrisse depois — olhando um REGISTER sair com IP interno — só
; tinha o caminho de editar variável do Ansible e rodar o playbook de
; novo. Agora o endereço público e as faixas locais vêm do console
; (Conectividade > Configurações de Rede), e o arquivo abaixo é gerado como qualquer outro.
; ------------------------------------------------------------------
#include "telium/pjsip.transports.conf"

#include "telium/pjsip.acl.conf"
#include "telium/pjsip.trunks.conf"
#include "telium/pjsip.endpoints.conf"
#include "telium/pjsip_custom.conf"
