; {{ ansible_managed }}
; Transportes e globais ficam aqui (estático).
; Endpoints e troncos são gerados pela API em {{ asterisk_gerado_dir }}.

[global]
type = global
user_agent = Telium PABX
default_outbound_endpoint = default_outbound
endpoint_identifier_order = ip,username,anonymous

[system]
type = system
timer_t1 = 500
timer_b  = 32000

[transport-udp]
type      = transport
protocol  = udp
bind      = 0.0.0.0:{{ sip_porta }}
{% for rede in redes_locais %}
local_net = {{ rede }}
{% endfor %}
{% if nat_ip_publico %}
external_media_address     = {{ nat_ip_publico }}
external_signaling_address = {{ nat_ip_publico }}
{% endif %}

[transport-tcp]
type     = transport
protocol = tcp
bind     = 0.0.0.0:{{ sip_porta }}
{% for rede in redes_locais %}
local_net = {{ rede }}
{% endfor %}

; SIP TLS na 5061. O par vem do módulo de certificados do console;
; até alguém enviar um, é o autoassinado de fábrica — o suficiente para
; cifrar a sinalização, mas o telefone vai pedir para confiar nele.
[transport-tls]
type          = transport
protocol      = tls
bind          = 0.0.0.0:{{ sip_tls_porta }}
cert_file     = {{ cert_asterisk_dir }}/asterisk.crt
priv_key_file = {{ cert_asterisk_dir }}/asterisk.key
method        = tlsv1_2
{% for rede in redes_locais %}
local_net = {{ rede }}
{% endfor %}
{% if nat_ip_publico %}
external_media_address     = {{ nat_ip_publico }}
external_signaling_address = {{ nat_ip_publico }}
{% endif %}

; ------------------------------------------------------------------
; WebRTC: o navegador fala direto com o Asterisk.
;
; Fica preso em 127.0.0.1 porque quem atende o navegador é o nginx, que
; já termina TLS com o certificado do console e repassa em /ws. Assim o
; softphone usa o mesmo endereço e o mesmo certificado do resto do
; sistema, e não há uma segunda porta TLS para manter.
;
; O ramal marcado como WebRTC no console sai com este transporte, e o
; gerador liga junto o que o navegador exige: AVPF, ICE, rtcp-mux e
; DTLS — faltando qualquer um, a chamada conecta e fica muda.
; ------------------------------------------------------------------
[transport-wss]
type     = transport
protocol = wss
bind     = 127.0.0.1:{{ ast_http_porta }}

#include "telium/pjsip.acl.conf"
#include "telium/pjsip.trunks.conf"
#include "telium/pjsip.endpoints.conf"
#include "telium/pjsip_custom.conf"
