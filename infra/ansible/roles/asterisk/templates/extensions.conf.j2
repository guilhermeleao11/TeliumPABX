; {{ ansible_managed }}
; Dialplan base. Os contextos telium-* são gerados pela API.

[general]
static       = yes
writeprotect = yes
clearglobalvars = no

[globals]
TELIUM_TZ        = {{ pabx_timezone }}
TELIUM_MOH       = default
TELIUM_GRAVACOES = /var/spool/asterisk/monitor
TELIUM_EMPRESA   = {{ pabx_empresa }}

; ------------------------------------------------------------------
; Sub-rotina de gravação — chamada pelos contextos gerados
;   ${ARG1} = entrada|saida|interna
; ------------------------------------------------------------------
[sub-gravar]
; Uma chamada pode passar por ramal, fila e rota; sem esta guarda, o
; MixMonitor entraria mais de uma vez no mesmo canal.
exten => s,1,GotoIf($["${TELIUM_GRAVANDO}" = "1"]?ja)
 same => n,Set(__TELIUM_GRAVANDO=1)
 ; o destino vem do contexto que chamou: dentro da sub-rotina ${EXTEN}
 ; é sempre "s", e o nome do arquivo saía sem o número discado
 same => n,Set(TELIUM_DEST=${IF($["${TELIUM_DESTINO}" != ""]?${TELIUM_DESTINO}:${EXTEN})})
 ; nome próprio: TELIUM_GRAV são as regras do ramal, que o sub-decidir-gravacao lê
 same => n,Set(__TELIUM_GRAVARQ=${STRFTIME(${EPOCH},,%Y/%m/%d)}/${STRFTIME(${EPOCH},,%H%M%S)}-${ARG1}-${CALLERID(num)}-${TELIUM_DEST}-${UNIQUEID}.wav)
 same => n,System(mkdir -p ${TELIUM_GRAVACOES}/${STRFTIME(${EPOCH},,%Y/%m/%d)})
 same => n,MixMonitor(${TELIUM_GRAVACOES}/${TELIUM_GRAVARQ},b)
 same => n,Set(CDR(gravacao)=${TELIUM_GRAVARQ})
 same => n,Return()
 same => n(ja),NoOp(Esta chamada já está sendo gravada)
 same => n,Return()

; ------------------------------------------------------------------
; Sub-rotina: decidir se esta chamada é gravada
;   ARG1 = qual das quatro regras do ramal vale nesta chamada
;          1 externa recebida · 2 externa feita
;          3 interna recebida · 4 interna feita
;   ARG2 = o que o outro lado pede: "sim"/"nao" da fila ou da rota, ou a
;          própria regra do ramal que recebe (forcar/sim/indiferente/
;          nao/nunca) numa chamada interna
;   ARG3 = sentido, só para o nome do arquivo
;
; As regras vêm do próprio endpoint, em ${TELIUM_GRAV}, separadas por
; barra vertical. A ordem de desempate é a mesma dos dois lados: "nunca"
; proíbe, "forçar" obriga, e só depois vale a preferência de cada um.
; ------------------------------------------------------------------
[sub-decidir-gravacao]
exten => s,1,Set(TELIUM_REGRA=${CUT(TELIUM_GRAV,|,${ARG1})})
 same => n,NoOp(Regra de gravação ${ARG1}: ${TELIUM_REGRA} — outro lado: ${ARG2})
 ; uma proibição de qualquer um dos lados encerra o assunto
 same => n,GotoIf($["${TELIUM_REGRA}" = "nunca" | "${ARG2}" = "nunca"]?proibido)
 ; e um "forçar" de qualquer um dos lados também
 same => n,GotoIf($["${TELIUM_REGRA}" = "forcar" | "${ARG2}" = "forcar"]?sim)
 same => n,GotoIf($["${TELIUM_REGRA}" = "nao"]?nao)
 same => n,GotoIf($["${TELIUM_REGRA}" = "sim"]?sim)
 ; "não importa": vale o que a fila, a rota ou o outro ramal pediu
 same => n,GotoIf($["${ARG2}" = "sim"]?sim)
 same => n(nao),NoOp(Chamada não será gravada)
 same => n,Return()
 same => n(sim),GoSub(sub-gravar,s,1(${ARG3}))
 same => n,Return()
 ; "Nunca" vale mesmo com a gravação já correndo: a rota de entrada
 ; decide antes de saber qual ramal vai atender. O TELIUM_GRAVANDO fica
 ; ligado para nenhuma etapa seguinte (fila, grupo) voltar a gravar.
 same => n(proibido),NoOp(Gravação proibida por uma das partes)
 same => n,ExecIf($["${TELIUM_GRAVANDO}" = "1"]?StopMixMonitor())
 same => n,ExecIf($["${TELIUM_GRAVANDO}" = "1"]?Set(CDR(gravacao)=))
 same => n,Set(__TELIUM_GRAVANDO=1)
 same => n,Return()

; ------------------------------------------------------------------
; Sub-rotina: ligar para um ramal
;   ARG1 = número · ARG2 = tempo de toque · ARG3 = mailbox (vazio = sem correio)
;   ARG4 = opções do Dial do ramal (vazio = tT)
; ------------------------------------------------------------------
[sub-ramal]
exten => s,1,NoOp(Chamando ramal ${ARG1})
 ; dono do siga-me e do desvio que saírem daqui: é a permissão dele que
 ; vale no Local/telium-desvio (ver sub-desvio-dono)
 same => n,Set(__TELIUM_DONO=${ARG1})
 same => n,Set(TELIUM_R=${ARG1})
 same => n,Set(TELIUM_TOQUE=${ARG2})
 same => n,Set(TELIUM_VM=${ARG3})
 same => n,Set(TELIUM_OPC=${IF($["${ARG4}" != ""]?${ARG4}:tT)})
 ; guarda quem ligou: é o que *69, *39 e *32 usam depois
 same => n,ExecIf($["${CALLERID(num)}" != ""]?Set(DB(ultimochamador/${ARG1})=${CALLERID(num)}))

 ; desvio de todas as chamadas vence tudo, inclusive o não perturbe
 same => n,Set(TELIUM_CF=${DB(cf/${ARG1})})
 same => n,GotoIf($["${TELIUM_CF}" != ""]?desviar)

 ; não perturbe
 same => n,GotoIf($[${DB_EXISTS(dnd/${ARG1})}]?ocupado)

 ; sem chamada em espera, ramal já em uso responde ocupado
 same => n,GotoIf($[${DB_EXISTS(cw/${ARG1})}]?monta)
 same => n,Set(TELIUM_EST=${DEVICE_STATE(PJSIP/${ARG1})})
 same => n,GotoIf($["${TELIUM_EST}" = "INUSE" | "${TELIUM_EST}" = "BUSY" | "${TELIUM_EST}" = "RINGINUSE"]?ocupado)

 ; siga-me: "junto" toca o ramal e o destino ao mesmo tempo; "depois"
 ; só procura o destino quando o ramal não atende.
 same => n(monta),Set(TELIUM_ALVO=PJSIP/${ARG1})
 same => n,Set(TELIUM_FMF=${DB(sigame/${ARG1})})
 same => n,Set(TELIUM_FMF_MODO=${DB(sigame-modo/${ARG1})})
 same => n,ExecIf($["${TELIUM_FMF}" != "" & "${TELIUM_FMF_MODO}" != "depois"]?Set(TELIUM_ALVO=PJSIP/${ARG1}&Local/${TELIUM_FMF}@telium-desvio))

 ; Atendimento automático: o telefone do destino abre o viva-voz sem
 ; tocar. Só para chamada interna — ninguém quer o aparelho abrindo som
 ; sozinho com alguém de fora na linha. O "b" roda a sub-rotina no canal
 ; de quem recebe, antes de ele ser chamado, que é o único lugar onde dá
 ; para acrescentar cabeçalho no INVITE que vai para o aparelho.
 same => n,ExecIf($[${DB_EXISTS(autoatende/${ARG1})} & "${TELIUM_RAMAL}" != ""]?Set(TELIUM_OPC=${TELIUM_OPC}b(sub-autoatende^s^1)))
 same => n,Dial(${TELIUM_ALVO},${TELIUM_TOQUE},${TELIUM_OPC})
 same => n,NoOp(Resultado: ${DIALSTATUS})

 same => n,Set(TELIUM_CFB=${DB(cfb/${ARG1})})
 same => n,Set(TELIUM_CFU=${DB(cfu/${ARG1})})
 same => n,GotoIf($["${DIALSTATUS}" != "ANSWER" & "${TELIUM_FMF}" != "" & "${TELIUM_FMF_MODO}" = "depois"]?sigame)
 same => n,GotoIf($["${DIALSTATUS}" = "BUSY" & "${TELIUM_CFB}" != ""]?desviar_ocupado)
 same => n,GotoIf($["${DIALSTATUS}" != "ANSWER" & "${TELIUM_CFU}" != ""]?desviar_naoatende)
 same => n,GoSub(sub-perdida,s,1(${ARG1}))
 same => n,GotoIf($["${TELIUM_VM}" = ""]?sem_vm)
 same => n,ExecIf($["${DIALSTATUS}" = "BUSY"]?VoiceMail(${TELIUM_VM},b))
 same => n,ExecIf($["${DIALSTATUS}" = "NOANSWER"]?VoiceMail(${TELIUM_VM},u))
 same => n,ExecIf($["${DIALSTATUS}" = "CHANUNAVAIL"]?VoiceMail(${TELIUM_VM},u))
 same => n(sem_vm),Return()

 same => n(sigame),NoOp(Siga-me de ${TELIUM_R} para ${TELIUM_FMF})
 ; o siga-me costuma cair num celular, que precisa de mais tempo de
 ; toque que o ramal de mesa — e de um Dial com prazo, senão a
 ; chamada acaba na caixa postal da operadora do celular em vez da
 ; caixa postal da empresa
 same => n,Set(TELIUM_TSIG=${IF($[${DB_EXISTS(sigame-toque/${TELIUM_R})}]?${DB(sigame-toque/${TELIUM_R})}:${TELIUM_TOQUE})})
 same => n,Dial(Local/${TELIUM_FMF}@telium-desvio,${TELIUM_TSIG},${TELIUM_OPC})
 same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?sem_vm)
 same => n,GotoIf($["${TELIUM_VM}" = ""]?sem_vm)
 same => n,VoiceMail(${TELIUM_VM},u)
 same => n,Return()

 same => n(desviar),NoOp(Desvio de todas: ${TELIUM_R} para ${TELIUM_CF})
 same => n,Goto(telium-desvio,${TELIUM_CF},1)
 same => n(desviar_ocupado),NoOp(Desvio por ocupado: ${TELIUM_R} para ${TELIUM_CFB})
 same => n,Goto(telium-desvio,${TELIUM_CFB},1)
 same => n(desviar_naoatende),NoOp(Desvio por não atender: ${TELIUM_R} para ${TELIUM_CFU})
 same => n,Goto(telium-desvio,${TELIUM_CFU},1)

 same => n(ocupado),NoOp(Ramal ${TELIUM_R} indisponível)
 same => n,GoSub(sub-perdida,s,1(${ARG1}))
 same => n,Set(TELIUM_CFB=${DB(cfb/${ARG1})})
 same => n,GotoIf($["${TELIUM_CFB}" != ""]?desviar_ocupado)
 same => n,GotoIf($["${TELIUM_VM}" = ""]?so_ocupado)
 same => n,VoiceMail(${TELIUM_VM},b)
 same => n,Return()
 same => n(so_ocupado),Busy(5)
 same => n,Return()

; ------------------------------------------------------------------
; Sub-rotina: pedir ao telefone que atenda sozinho
;
; Roda no canal de quem recebe, pela opção b do Dial. Cada fabricante lê
; um cabeçalho diferente, então vão os dois mais comuns: Call-Info é o
; da Polycom, Yealink, Grandstream e Fanvil; Alert-Info é o que
; Intelbras e alguns modelos antigos entendem.
; ------------------------------------------------------------------
[sub-autoatende]
exten => s,1,NoOp(Pedindo atendimento automático a ${EXTEN})
 same => n,Set(PJSIP_HEADER(add,Call-Info)=<uri>\;answer-after=0)
 same => n,Set(PJSIP_HEADER(add,Alert-Info)=Auto Answer)
 same => n,Return()

; ------------------------------------------------------------------
; Sub-rotina: destino de desvio e de siga-me
; Entra pelo contexto interno, então vale ramal, fila, URA ou externo.
; ------------------------------------------------------------------
[telium-desvio]
exten => _X.,1,NoOp(Destino de desvio: ${EXTEN})
 same => n,GoSub(sub-desvio-dono,s,1)
 same => n,Goto(interno,${EXTEN},1)
exten => _*X.,1,NoOp(Destino de desvio: ${EXTEN})
 same => n,GoSub(sub-desvio-dono,s,1)
 same => n,Goto(interno,${EXTEN},1)

; Quem configurou o desvio responde por ele: a chamada sai com a
; permissão do ramal dono (família "perm", gravada pelo "aplicar"), e não
; com a de quem ligou — que, vinda de fora, não tem permissão nenhuma e
; passava com tudo liberado. Dono sem registro fica só com emergência.
[sub-desvio-dono]
exten => s,1,GotoIf($["${TELIUM_DONO}" = ""]?fim)
 same => n,Set(TELIUM_PERM=${DB(perm/${TELIUM_DONO})})
 same => n,ExecIf($["${TELIUM_PERM}" = ""]?Set(TELIUM_PERM=emergencia))
 same => n(fim),Return()

; ------------------------------------------------------------------
; Sub-rotina: registrar chamada perdida
;   ARG1 = ramal que não atendeu
; Só registra quando o ramal pediu o aviso (código *58). A gravação vai
; para a tabela de eventos, que é o que o console mostra.
; ------------------------------------------------------------------
[sub-perdida]
exten => s,1,GotoIf($[${DB_EXISTS(perdidas/${ARG1})}]?registra)
 same => n,Return()
 same => n(registra),NoOp(Chamada perdida no ramal ${ARG1}, de ${CALLERID(num)})
 same => n,Set(ODBC_TELIUM_PERDIDA(${ARG1},${CALLERID(num)})=${CALLERID(name)})
 same => n,Return()

; ------------------------------------------------------------------
; Sub-rotina: checar permissão de discagem do ramal
;   ARG1 = classe da rota (local|celular|ddd|ddi|emergencia|especial)
;   A lista permitida chega em ${TELIUM_PERM}, gravada no endpoint PJSIP.
; ------------------------------------------------------------------
[sub-permissao]
 ; Transferência às cegas: o canal transferido é o de quem estava do outro
 ; lado (muitas vezes o do tronco, sem TELIUM_PERM) e quem manda é o ramal
 ; que transferiu — senão um ramal só-local transferia a chamada recebida
 ; para um número internacional.
exten => s,1,GotoIf($["${TELIUM_PERM}" != "" | "${BLINDTRANSFER}" = ""]?confere)
 same => n,Set(TELIUM_TRF=${CUT(BLINDTRANSFER,-,1)})
 same => n,Set(TELIUM_TRF=${CUT(TELIUM_TRF,/,2)})
 same => n,GotoIf($["${TELIUM_TRF}" = ""]?confere)
 same => n,Set(TELIUM_PERM=${DB(perm/${TELIUM_TRF})})
 same => n,ExecIf($["${TELIUM_PERM}" = ""]?Set(TELIUM_PERM=emergencia))
 ; Sem TELIUM_PERM nenhum é destino que o administrador configurou (URA
 ; para número externo, retorno do call center, DISA): liberado.
 same => n(confere),GotoIf($["${TELIUM_PERM}" = ""]?permitido)
 same => n,GotoIf($[${REGEX("(^|,)${ARG1}(,|$)" ${TELIUM_PERM})} = 1]?permitido)
 same => n,NoOp(Ramal ${CALLERID(num)} sem permissão para ${ARG1})
 same => n,Answer()
 same => n,Wait(1)
 same => n,Playback(cannot-complete-as-dialed)
 same => n,Hangup(31)
 same => n(permitido),Return()

; ------------------------------------------------------------------
; Sub-rotina: segurar o ramal no teto de chamadas de saída
;   O teto chega em ${TELIUM_MAXSAIDA}, gravado no endpoint. Sem teto
;   cadastrado a sub-rotina só volta — é o caso da maioria dos ramais.
;
;   O GROUP fica preso ao canal, então a contagem cai sozinha quando a
;   chamada termina, inclusive se a central for reiniciada no meio.
; ------------------------------------------------------------------
[sub-limite-saida]
exten => s,1,GotoIf($["${TELIUM_MAXSAIDA}" = ""]?livre)
 same => n,Set(GROUP(saida)=${TELIUM_RAMAL})
 same => n,GotoIf($[${GROUP_COUNT(${TELIUM_RAMAL}@saida)} <= ${TELIUM_MAXSAIDA}]?livre)
 same => n,NoOp(Ramal ${TELIUM_RAMAL} já está com ${TELIUM_MAXSAIDA} chamadas de saída)
 same => n,Answer()
 same => n,Wait(1)
 same => n,Playback(all-circuits-busy-now)
 same => n,Hangup(21)
 same => n(livre),Return()

; ------------------------------------------------------------------
; Sub-rotina: escolher o número que a operadora vê
;   ARG1 = CID do tronco, quando cadastrado
;   ${TELIUM_CID} = número de saída próprio do ramal, quando cadastrado
;
;   O "callerid" do endpoint do tronco não serve para isto: o Asterisk usa
;   o CALLERID do canal quando ele existe, e o canal chega aqui com o
;   número interno do ramal — era isso que ia para a operadora. Sem
;   nenhum dos dois cadastrados a chamada sai como Anonymous e a
;   operadora recusa, então quem discou fica sabendo.
;
;   Aqui só se escolhe o número. Quem o põe na chamada é sub-cid-tronco,
;   no canal que vai para a operadora: trocar o CALLERID de quem discou
;   levava o número da empresa para o "origem" do CDR, e a chamada sumia
;   dos relatórios por ramal, do "minhas chamadas" e da tarifação.
; ------------------------------------------------------------------
[sub-cid-saida]
exten => s,1,Set(TELIUM_CIDSAI=${IF($["${TELIUM_CID}" != ""]?${TELIUM_CID}:${ARG1})})
 same => n,ExecIf($["${TELIUM_CIDSAI}" = ""]?NoOp(Sem CID de saída no ramal nem no tronco))
 same => n,Return()

; Roda no canal de saída, antes de ele discar (opção b do Dial).
;   ARG1 = o número escolhido por sub-cid-saida
[sub-cid-tronco]
exten => s,1,GotoIf($["${ARG1}" = ""]?fim)
 same => n,Set(CALLERID(num)=${ARG1})
 same => n,Set(CALLERID(name)=${ARG1})
 same => n,Set(CONNECTEDLINE(num,i)=${ARG1})
 same => n,Set(CONNECTEDLINE(name,i)=${ARG1})
 same => n(fim),Return()

; ------------------------------------------------------------------
; Sub-rotina: barrar entrante que esteja na lista negra
;   Pergunta ao próprio Asterisk se o número tem extensão no contexto
;   gerado, o que faz padrões (_11999X.) valerem sem varrer tabela.
; ------------------------------------------------------------------
[sub-listanegra]
exten => s,1,GotoIf($["${CALLERID(num)}" = ""]?segue)
 ; allowlist: primeiro a base do Asterisk (o que entrou por código de
 ; recurso, vale na hora), depois o contexto gerado (padrões do console)
 same => n,GotoIf($[${DB_EXISTS(allowlist-pausada/geral)}]?sem_allowlist)
 same => n,GotoIf($[${DB_EXISTS(allowlist/${CALLERID(num)})}]?segue)
 same => n,GotoIf($[${DIALPLAN_EXISTS(telium-allowlist,${CALLERID(num)},1)}]?segue)
 same => n(sem_allowlist),GotoIf($[${DB_EXISTS(listanegra/${CALLERID(num)})}]?bloqueia)
 same => n,GotoIf($[${DIALPLAN_EXISTS(telium-listanegra,${CALLERID(num)},1)}]?bloqueia)
 same => n(segue),Return()
 same => n(bloqueia),NoOp(Chamada de ${CALLERID(num)} barrada pela lista negra)
 same => n,GotoIf($[${DIALPLAN_EXISTS(telium-listanegra,${CALLERID(num)},1)}]?trata)
 same => n,Hangup(21)
 same => n(trata),Goto(telium-listanegra,${CALLERID(num)},1)

; ------------------------------------------------------------------
; Sub-rotina: confirmar um código de recurso
;   ARG1 = arquivo de áudio a tocar (activated, de-activated, …)
; ------------------------------------------------------------------
[sub-confirma]
exten => s,1,Answer()
 same => n,Wait(1)
 same => n,Playback(${ARG1})
 same => n,Hangup()

; ------------------------------------------------------------------
; Contexto dos ramais
; ------------------------------------------------------------------
[interno]
include => telium-recursos
include => telium-ramais
include => telium-grupos
include => telium-filas
include => telium-conferencias
include => telium-paging
include => telium-estacionamento
include => telium-ura
include => telium-saida
include => telium-custom

; Número que não casa com nada: sem isto a chamada apenas cai e quem
; discou não sabe se errou o número ou se a central está com problema.
exten => i,1,NoOp(Número inválido discado: ${INVALID_EXTEN})
 same => n,Answer()
 same => n,Wait(1)
 same => n,Playback(ss-noservice)
 same => n,Hangup(1)
exten => t,1,NoOp(Sem discar a tempo)
 same => n,Hangup()

; ------------------------------------------------------------------
; Chamadas vindas dos troncos
; ------------------------------------------------------------------
[de-tronco]
include => telium-entrada

; ------------------------------------------------------------------
; Sub-rotina: confirmação de atendimento numa fila
;
; Roda no canal de quem vai atender, antes de juntar as pontas (opção U
; do Dial). Se o agente não apertar 1, GOSUB_RESULT=ABORT desfaz a
; ligação e a fila procura outro — é o que evita a chamada morrer na
; caixa postal do celular de um agente remoto.
;
; O áudio vem em ${TELIUM_AUDIO}, herdado do contexto da fila.
; ------------------------------------------------------------------
[sub-confirmar-atendimento]
exten => s,1,Answer()
 same => n,Read(TELIUM_OK,${IF($["${TELIUM_AUDIO}" != ""]?${TELIUM_AUDIO}:beep)},1,,1,6)
 same => n,GotoIf($["${TELIUM_OK}" = "1"]?aceita)
 same => n,NoOp(Agente não confirmou o atendimento — a fila procura outro)
 same => n,Set(GOSUB_RESULT=ABORT)
 same => n,Return()
 same => n(aceita),NoOp(Atendimento confirmado)
 same => n,Return()

; ------------------------------------------------------------------
; Despertador: o disparador liga para o ramal e cai aqui.
; A hora marcada fica na base do Asterisk (família despertar), gravada
; pelo código *68.
; ------------------------------------------------------------------
[telium-despertador]
exten => s,1,NoOp(Despertador do ramal ${CALLERID(num)})
 same => n,Answer()
 same => n,Wait(1)
 ; O disparador deixa aqui o anúncio escolhido para este ramal.
 same => n,Set(TELIUM_ANUN=${DB(despertar-anuncio/${CALLERID(num)})})
 same => n,NoOp(${DB_DELETE(despertar-anuncio/${CALLERID(num)})})
 same => n,GotoIf($["${TELIUM_ANUN}" = ""]?hora)
 same => n,Goto(telium-anuncios,${TELIUM_ANUN},1)
 same => n(hora),Playback(hello)
 same => n,SayUnixTime(,${TELIUM_TZ},HM)
 same => n,Wait(1)
 same => n,Playback(goodbye)
 same => n,Hangup()

; Contexto para personalizações. Fica aqui vazio só para o include do
; contexto interno não reclamar numa instalação recém-feita; o conteúdo
; de verdade vai em telium/extensions_custom.conf, que não é sobrescrito.
[telium-custom]

; Contexto de bloqueio: usado por ramais sem permissão de saída
[telium-bloqueado]
exten => _X.,1,Answer()
 same => n,Wait(1)
 same => n,Playback(cannot-complete-as-dialed)
 same => n,Hangup(31)

#include "telium/extensions.recursos.conf"
#include "telium/extensions.listanegra.conf"
#include "telium/extensions.allowlist.conf"
#include "telium/extensions.ramais.conf"
#include "telium/extensions.grupos.conf"
#include "telium/extensions.filas.conf"
#include "telium/extensions.callcenter.conf"
#include "telium/extensions.pesquisa.conf"
#include "telium/extensions.confirmacao.conf"
#include "telium/extensions.conferencias.conf"
#include "telium/extensions.anuncios.conf"
#include "telium/extensions.condicoes.conf"
#include "telium/extensions.estacionamento.conf"
#include "telium/extensions.ura.conf"
#include "telium/extensions.saida.conf"
; Traz também os contextos de entrada de cada tronco, que é onde o
; número recebido é normalizado e onde a chamada SEM número deixa de
; virar 404. Ficam no mesmo arquivo de propósito: um arquivo novo
; exigiria mexer aqui, e este aqui só o playbook reescreve.
#include "telium/extensions.entrada.conf"
#include "telium/extensions.paging.conf"
#include "telium/extensions.disa.conf"
#include "telium/extensions_custom.conf"
