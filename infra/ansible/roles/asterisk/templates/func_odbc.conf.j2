; {{ ansible_managed }}
;
; Funções de banco usadas pelos códigos de recurso. São as únicas coisas
; que o dialplan grava direto no MariaDB — o resto passa pela API.
;
; O usuário do DSN tem SELECT, INSERT e UPDATE, e não DELETE: por isso
; "remover da lista" é ativo = 0, o que também deixa o histórico visível
; no console em vez de sumir com ele.

; ------------------------------------------------------------------
; Chamada perdida: Set(ODBC_TELIUM_PERDIDA(<ramal>,<origem>)=<nome>)
; ------------------------------------------------------------------
[TELIUM_PERDIDA]
dsn=telium
writesql=INSERT INTO eventos (tipo, payload) VALUES ('chamada_perdida', CONCAT('{"ramal":"', '${SQL_ESC(${ARG1})}', '","origem":"', '${SQL_ESC(${ARG2})}', '","nome":"', '${SQL_ESC(${VAL1})}', '"}'))

; ------------------------------------------------------------------
; Lista negra: Set(ODBC_TELIUM_LN_ADD(<numero>)=<ramal que pediu>)
; ------------------------------------------------------------------
[TELIUM_LN_ADD]
dsn=telium
writesql=INSERT INTO lista_negra (numero, descricao, tratamento, ativo) VALUES ('${SQL_ESC(${ARG1})}', CONCAT('Bloqueado pelo ramal ', '${SQL_ESC(${VAL1})}'), 'desligar', 1) ON DUPLICATE KEY UPDATE ativo = 1

[TELIUM_LN_DEL]
dsn=telium
writesql=UPDATE lista_negra SET ativo = 0 WHERE numero = '${SQL_ESC(${ARG1})}'

; ------------------------------------------------------------------
; Allowlist
; ------------------------------------------------------------------
[TELIUM_AL_ADD]
dsn=telium
writesql=INSERT INTO lista_permitida (numero, descricao, ativo) VALUES ('${SQL_ESC(${ARG1})}', CONCAT('Liberado pelo ramal ', '${SQL_ESC(${VAL1})}'), 1) ON DUPLICATE KEY UPDATE ativo = 1

[TELIUM_AL_DEL]
dsn=telium
writesql=UPDATE lista_permitida SET ativo = 0 WHERE numero = '${SQL_ESC(${ARG1})}'

; ------------------------------------------------------------------
; Discagem rápida da agenda: ${ODBC_TELIUM_CONTATO(<código curto>)}
; Devolve o primeiro telefone preenchido do contato.
; ------------------------------------------------------------------
[TELIUM_CONTATO]
dsn=telium
readsql=SELECT COALESCE(NULLIF(numero,''), NULLIF(celular,''), NULLIF(telefone,''), NULLIF(ramal_interno,'')) FROM contatos WHERE discagem_rapida = '${SQL_ESC(${ARG1})}' AND ativo = 1 LIMIT 1

; ------------------------------------------------------------------
; Nome do contato, para anunciar antes de ligar
; ------------------------------------------------------------------
[TELIUM_CONTATO_NOME]
dsn=telium
readsql=SELECT nome FROM contatos WHERE discagem_rapida = '${SQL_ESC(${ARG1})}' AND ativo = 1 LIMIT 1

; ------------------------------------------------------------------
; Pesquisa de satisfação:
;   Set(ODBC_TELIUM_PESQUISA(<id>,<fila>,<agente>,<ramal>,<origem>,<uniqueid>,<status>)=<nota>)
; status: respondida · sem_resposta · invalida · desligou. Quem ouviu e não
; respondeu também é resultado, e some se a gente não registrar.
; A resposta leva a escala vigente (mínimo, máximo e sentido) e o índice de
; 0 a 100 já calculado no sentido certo: mudar a escala depois não reescreve
; o que o cliente disse, e pesquisas de escalas diferentes se comparam.
; ------------------------------------------------------------------
[TELIUM_PESQUISA]
dsn=telium
writesql=INSERT INTO pesquisa_respostas (pesquisa_id, fila, agente, ramal, origem, uniqueid, status, nota, nota_min, nota_max, sentido, satisfacao) SELECT p.id, NULLIF('${SQL_ESC(${ARG2})}',''), NULLIF('${SQL_ESC(${ARG3})}',''), NULLIF('${SQL_ESC(${ARG4})}',''), NULLIF('${SQL_ESC(${ARG5})}',''), NULLIF('${SQL_ESC(${ARG6})}',''), IF('${SQL_ESC(${ARG7})}' IN ('respondida','sem_resposta','invalida','desligou'), '${SQL_ESC(${ARG7})}', 'sem_resposta'), n.nota, p.nota_min, p.nota_max, p.sentido, IF(n.nota IS NULL, NULL, ROUND(100 * IF(p.sentido = 'menor_melhor', p.nota_max - n.nota, n.nota - p.nota_min) / NULLIF(p.nota_max - p.nota_min, 0), 2)) FROM pesquisas p JOIN (SELECT IF('${SQL_ESC(${VAL1})}' REGEXP '^[0-9]{1,2}$', CAST('${SQL_ESC(${VAL1})}' AS UNSIGNED), NULL) AS nota) n WHERE p.id = CAST('${SQL_ESC(${ARG1})}' AS UNSIGNED)

; ------------------------------------------------------------------
; Registro de gravação:
;   Set(ODBC_TELIUM_GRAVACAO(<uniqueid>,<arquivo>,<origem>,<destino>,<tag>)=<nome>)
; O CDR não cobre a conferência, que é uma ponte e não uma chamada; sem
; esta linha a gravação existiria no disco e não na tela.
; ------------------------------------------------------------------
[TELIUM_GRAVACAO]
dsn=telium
writesql=INSERT INTO gravacoes (uniqueid, arquivo, origem, destino, tags, inicio) VALUES ('${SQL_ESC(${ARG1})}', '${SQL_ESC(${ARG2})}', NULLIF('${SQL_ESC(${ARG3})}',''), NULLIF('${SQL_ESC(${ARG4})}',''), NULLIF('${SQL_ESC(${ARG5})}',''), NOW())

; ------------------------------------------------------------------
; Siga-me pelo telefone:
;   Set(ODBC_TELIUM_SIGAME(<ramal>)=<destino>)   — vazio desliga
; A base do Asterisk é o que vale em tempo de chamada; isto aqui é para
; o console mostrar a mesma coisa que o ramal configurou pelo telefone.
; ------------------------------------------------------------------
[TELIUM_SIGAME]
dsn=telium
writesql=UPDATE ramais SET siga_me = NULLIF('${SQL_ESC(${VAL1})}',''), siga_me_ativo = IF('${SQL_ESC(${VAL1})}' = '', 0, 1) WHERE numero = '${SQL_ESC(${ARG1})}'

; ------------------------------------------------------------------
; Não perturbe, chamada em espera e interfonia pelo telefone:
;   Set(ODBC_TELIUM_DND(<ramal>)=1|0)
;   Set(ODBC_TELIUM_CW(<ramal>)=1|0)
;   Set(ODBC_TELIUM_INTERFONIA(<ramal>)=permitir|negar)
; O "aplicar" repõe a base do Asterisk a partir do banco; sem gravar
; aqui, o que o ramal ligou pelo telefone voltava atrás na aplicação
; seguinte, sem ninguém saber por quê.
; ------------------------------------------------------------------
[TELIUM_DND]
dsn=telium
writesql=UPDATE ramais SET dnd = IF('${SQL_ESC(${VAL1})}' = '1', 1, 0) WHERE numero = '${SQL_ESC(${ARG1})}'

[TELIUM_CW]
dsn=telium
writesql=UPDATE ramais SET chamada_espera = IF('${SQL_ESC(${VAL1})}' = '1', 1, 0) WHERE numero = '${SQL_ESC(${ARG1})}'

[TELIUM_INTERFONIA]
dsn=telium
writesql=UPDATE ramais SET interfonia = IF('${SQL_ESC(${VAL1})}' = 'negar', 'negar', 'permitir') WHERE numero = '${SQL_ESC(${ARG1})}'

; ------------------------------------------------------------------
; Call center — retorno pedido na espera:
;   Set(ODBC_TELIUM_CC_RETORNO(<fila>,<número>,<uniqueid>)=<nome>)
; ------------------------------------------------------------------
; O mesmo número com retorno já pendente nesta fila não ganha outro: quem
; aperta a tecla em duas ligações seguidas não recebe duas chamadas.
[TELIUM_CC_RETORNO]
dsn=telium
writesql=INSERT INTO cc_retornos (fila, numero, nome, callid) SELECT '${SQL_ESC(${ARG1})}', '${SQL_ESC(${ARG2})}', NULLIF('${SQL_ESC(${VALUE})}',''), NULLIF('${SQL_ESC(${ARG3})}','') FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM cc_retornos WHERE fila = '${SQL_ESC(${ARG1})}' AND numero = '${SQL_ESC(${ARG2})}' AND estado IN ('pendente','discando'))

; O agente atendeu o retorno: tira a linha do alcance do varredor de
; retornos presos, que religaria para um cliente ainda em conversa.
[TELIUM_CC_RETORNO_ATENDEU]
dsn=telium
writesql=UPDATE cc_retornos SET proxima_em = NOW() + INTERVAL 6 HOUR WHERE id = CAST('${SQL_ESC(${ARG1})}' AS UNSIGNED) AND estado = 'discando'

; A fila de um retorno, para o lado que entra na espera no lugar do cliente.
[TELIUM_CC_RETORNO_FILA]
dsn=telium
readsql=SELECT fila FROM cc_retornos WHERE id = CAST('${SQL_ESC(${ARG1})}' AS UNSIGNED) AND estado = 'discando'

; Resultado de um retorno: ANSWER conclui; SEMAGENTE não gasta tentativa;
; o resto volta para a fila de retornos, até esgotar as tentativas.
; SEMAGENTE de um retorno que o agente já atendeu (ATENDEU empurrou o
; proxima_em horas à frente) é ignorado: quem grava é o lado do cliente.
[TELIUM_CC_RETORNO_FIM]
dsn=telium
writesql=UPDATE cc_retornos r JOIN filas f ON f.numero = r.fila SET r.estado = IF('${SQL_ESC(${ARG2})}' = 'ANSWER', 'concluido', IF('${SQL_ESC(${ARG2})}' <> 'SEMAGENTE' AND r.tentativas >= f.retorno_tentativas, 'falhou', 'pendente')), r.resultado = '${SQL_ESC(${ARG2})}', r.proxima_em = NOW() + INTERVAL 3 MINUTE, r.concluido_em = IF('${SQL_ESC(${ARG2})}' = 'ANSWER', NOW(), NULL), r.tentativas = IF('${SQL_ESC(${ARG2})}' = 'SEMAGENTE' AND r.tentativas > 0, r.tentativas - 1, r.tentativas) WHERE r.id = CAST('${SQL_ESC(${ARG1})}' AS UNSIGNED) AND r.estado = 'discando' AND ('${SQL_ESC(${ARG2})}' <> 'SEMAGENTE' OR r.proxima_em < NOW() + INTERVAL 1 HOUR)
