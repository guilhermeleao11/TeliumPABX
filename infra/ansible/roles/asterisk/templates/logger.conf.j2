; {{ ansible_managed }}
[general]
dateformat = %F %T
use_callids = yes
; O queue_log vai para o banco (extconfig.conf), com os campos separados
; em data1…data5 — é o que o relatório consulta. Com o Asternic instalado,
; vai TAMBÉM para /var/log/asterisk/queue_log, que é o que ele lê.
queue_log = yes
queue_log_to_file = {{ 'yes' if (instalar_asternic | default(false) | bool) else 'no' }}
queue_adaptive_realtime = yes

[logfiles]
console  => notice,warning,error
messages => notice,warning,error
full     => notice,warning,error,verbose(3),dtmf
security => security
{% if syslog_central | default(false) %}
; Cópia para o syslog (facility local5), que o rsyslog encaminha ao
; syslog central do grupo VoIP Telium (role syslog). Os arquivos acima
; continuam: o fail2ban lê o security, e o console lê o messages.
syslog.local5 => notice,warning,error,debug,verbose
{% endif %}
