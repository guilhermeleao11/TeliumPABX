; {{ ansible_managed }}
;
; O que muda no dia a dia — tamanho do recado, texto do e-mail, formato —
; vem do console, no arquivo incluído logo abaixo. Aqui fica só o que
; depende da instalação.
[general]
skipms        = 3000
emaildateformat = %d/%m/%Y às %H:%M:%S
serveremail   = pabx@{{ pabx_hostname }}
fromstring    = {{ pabx_empresa }} — PABX
mailcmd       = /usr/sbin/sendmail -t
#include "telium/voicemail.geral.conf"

[zonemessages]
brasil = {{ pabx_timezone }}|'vm-received' q 'digits/at' HM

#include "telium/voicemail.conf"
