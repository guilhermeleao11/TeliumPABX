; {{ ansible_managed }}
[general]
format        = wav49|gsm|wav
attach        = yes
maxmsg        = 100
maxsecs       = 180
minsecs       = 2
skipms        = 3000
maxlogins     = 3
emaildateformat = %d/%m/%Y às %H:%M:%S
serveremail   = pabx@{{ pabx_hostname }}
fromstring    = {{ pabx_empresa }} — PABX
emailsubject  = Nova mensagem de voz de ${VM_CALLERID}
emailbody     = Olá ${VM_NAME},\n\nvocê recebeu uma mensagem de ${VM_CALLERID}\nem ${VM_DATE}, com duração de ${VM_DUR}.\n\nA gravação está anexada.\n\n-- {{ pabx_empresa }}
mailcmd       = /usr/sbin/sendmail -t

[zonemessages]
brasil = {{ pabx_timezone }}|'vm-received' q 'digits/at' HM

#include "telium/voicemail.conf"
