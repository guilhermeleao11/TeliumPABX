# {{ ansible_managed }}
general: {
        configs_folder = "{{ janus_prefix }}/etc/janus"
        plugins_folder = "{{ janus_prefix }}/lib/janus/plugins"
        transports_folder = "{{ janus_prefix }}/lib/janus/transports"
        events_folder = "{{ janus_prefix }}/lib/janus/events"
        loggers_folder = "{{ janus_prefix }}/lib/janus/loggers"

        debug_level = 4
        debug_timestamps = true
        debug_colors = false

        admin_secret = "{{ ami_senha }}"
        server_name = "Telium PABX"
        session_timeout = 60
        reclaim_session_timeout = 30
}

certificates: {
        cert_pem = "{{ tls_cert }}"
        cert_key = "{{ tls_key }}"
}

media: {
        ipv6 = false
        min_nack_queue = 500
        rtp_port_range = "{{ janus_rtp_inicio }}-{{ janus_rtp_fim }}"
        dtls_mtu = 1200
        no_media_timer = 5
        slowlink_threshold = 4
}

nat: {
        stun_server = "stun.l.google.com"
        stun_port = 19302
        nice_debug = false
        full_trickle = true
        ice_ignore_list = "vmnet,docker,veth"
{% if nat_ip_publico %}
        nat_1_1_mapping = "{{ nat_ip_publico }}"
{% endif %}
}

plugins: {
        # Só precisamos do plugin SIP nesta central
        disable = "libjanus_videoroom.so,libjanus_audiobridge.so,libjanus_streaming.so,libjanus_videocall.so,libjanus_voicemail.so,libjanus_textroom.so,libjanus_recordplay.so,libjanus_nosip.so,libjanus_echotest.so"
}

transports: {
        disable = "libjanus_pfunix.so"
}
