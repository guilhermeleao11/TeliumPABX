# Ajustes DESTA central — /etc/telium-servidor.yml, no próprio servidor.
#
# Este é o modelo. A instalação copia-o para /etc/telium-servidor.yml
# (só root) e grava nele o que pergunta: o nome da central, o cliente, o
# IP público, Janus, Asternic, SIP só para redes conhecidas, syslog.
# Para mudar algo depois, edite /etc/telium-servidor.yml no servidor e
# rode o playbook (de dentro ou de fora): o que estiver lá ganha do
# main.yml, e só o que vem por -e ganha dele.
#
# Mora no servidor, e não no clone, para qualquer técnico, de qualquer
# máquina, atualizar a central sem perder o que é dela.
#
# Escreva os valores por extenso: aqui não vale {{ variavel }}.
# Deixe só o que muda nesta central; o resto continua vindo do main.yml.

# Nome pelo qual o console, os telefones e o navegador chegam à central.
# A instalação PERGUNTA este nome na primeira vez e o grava aqui — não é
# preciso preencher à mão. Precisa resolver no DNS e ser alcançável de
# quem usa o console; um ".local" não serve para o softphone do navegador.
# Começa por letra, sem "_". Um IP também é aceito.
# pabx_hostname: "voz.suaempresa.com.br"

# Enquanto o nome acima ainda não existe no DNS, aponte o TURN (o áudio do
# softphone do navegador) direto para o IP público do servidor:
# turn_dominio: "200.170.198.144"

# Encaminhamento de log para o syslog central. Os IPs do main.yml são os
# do grupo VoIP da Telium; num cliente com outro syslog, troque aqui — ou
# desligue.
# syslog_central: false
# syslog_central_asterisk: "10.0.0.10"
# syslog_central_auth: "10.0.0.10"
# syslog_central_sistema: "10.0.0.10"

# Nome da empresa, usado na identificação da central.
# pabx_empresa: "Sua Empresa"

# Asternic Call Center Stats PRO (Call Center › Stats). Só com licença
# comprada para ESTE servidor: ela é presa ao MAC da placa de rede.
# instalar_asternic: true

# Arquivo da ferramenta de backup da empresa (a lista com linhas "I /etc",
# "I /home"…). O padrão é /root/.backup_telium: o playbook mantém nele um
# bloco marcado "Telium PABX" com o que é essencial da central, sem tocar
# nas outras linhas. Em outro lugar, informe aqui; vazio desliga.
# backup_empresa_lista: "/root/.backup_telium"
